{
  "name": "@buildcraft/backend",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run"
  },
  "dependencies": {
    "@buildcraft/shared": "*",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.0",
    "ws": "^8.16.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "knex": "^3.1.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "ioredis": "^5.3.0",
    "zod": "^3.22.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.4.0",
    "openai": "^4.28.0",
    "prom-client": "^15.1.0",
    "bullmq": "^5.1.0",
    "multer": "^1.4.5-lts.1",
    "mime-types": "^2.1.35",
    "nanoid": "^5.0.0",
    "http-status-codes": "^2.3.0",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/ws": "^8.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/mime-types": "^2.1.4",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "vitest": "^1.3.0",
    "@vitest/coverage-v8": "^1.3.0",
    "eslint": "^8.57.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^6.0.2"
  }
}
