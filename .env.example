# Application
NODE_ENV=development
APP_NAME=BuildCraft AI
APP_VERSION=1.0.0

# Backend
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://buildcraft:buildcraft@localhost:5432/buildcraft
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=buildcraft
DATABASE_PASSWORD=buildcraft
DATABASE_NAME=buildcraft
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (used for: cache, BullMQ queue, pub/sub event bus, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Object Storage (S3-compatible — works with AWS S3, MinIO, DigitalOcean Spaces)
STORAGE_PROVIDER=local
S3_BUCKET=buildcraft-storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=buildcraft
AWS_SECRET_ACCESS_KEY=buildcraft-secret

# Docker / Sandbox Execution
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_MAX_MEMORY=256m
SANDBOX_MAX_CPUS=0.5
SANDBOX_TIMEOUT_MS=300000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20

# Monitoring
SENTRY_DSN=
LOG_LEVEL=debug
ENABLE_METRICS=true
METRICS_PORT=9090

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=10000

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30000
CB_SUCCESS_THRESHOLD=3
